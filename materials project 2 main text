import requests

def search_patents(query, max_results=10):
    """
    Search USPTO PatentsView API for existing patents
    Free, no API key required
    """
    url = "https://search.patentsview.org/api/v1/patent/"
    
    params = {
        "q": {"_text_any": {"patent_abstract": query}},
        "f": ["patent_id", "patent_title", "patent_abstract",
              "patent_date", "assignee_organization"],
        "o": {"per_page": max_results}
    }
    
    try:
        response = requests.post(url, json=params)
        data = response.json()
        patents = data.get("patents", [])
        
        if not patents:
            print(f"No patents found for: {query}")
            return []
        
        results = []
        for p in patents:
            results.append({
                "id": p.get("patent_id"),
                "title": p.get("patent_title"),
                "date": p.get("patent_date"),
                "assignee": p.get("assignee_organization", 
                                  [{}])[0].get(
                                  "assignee_organization", "Unknown"),
                "abstract": p.get("patent_abstract", "")[:200]
            })
        return results
    
    except Exception as e:
        print(f"Patent search error: {e}")
        return []

# Run your specific searches
queries = [
    "rare earth fluoride gate dielectric agricultural sensor",
    "yttrium fluoride low power sensor humidity",
    "dysprosium fluoride dielectric insulator",
    "rare earth trifluoride transistor gate",
    "fluoride gate dielectric soil sensor"
]

print("=== PATENT LANDSCAPE SEARCH ===\n")
for query in queries:
    print(f"Query: '{query}'")
    results = search_patents(query)
    if results:
        for r in results[:3]:
            print(f"  FOUND: {r['title']} ({r['date']})")
            print(f"  Assignee: {r['assignee']}")
            print(f"  Abstract: {r['abstract']}...")
    else:
        print(f"  CLEAR — no patents found")
    print()
