EARTH_ABUNDANCE = {
    "O": 10, "Si": 9, "Al": 8, "Fe": 8, "Ca": 7,
    "Na": 7, "K": 7, "Mg": 7, "Ti": 6, "Mn": 5,
    "Zn": 4, "Cu": 4, "Ni": 3, "Cr": 3, "Sn": 2,
    "Co": 2, "Pb": 2, "Mo": 1, "W": 1, "Ta": 1,
    "Nb": 1, "Hf": 1, "Ce": 2, "Er": 1, "Gd": 1,
    "Pt": 0, "Au": 0, "Ir": 0, "Ac": 0, "Bi": 2
}

TOXIC_ELEMENTS = ["Ac", "Tc", "Po", "At", "Rn", "Fr", "Ra",
                   "Th", "Pa", "U", "Np", "Pu", "As", "Tl"]

def get_abundance_score(formula):
    score = 5
    for element, value in EARTH_ABUNDANCE.items():
        if element in formula:
            score = min(score, value)
    return score

def is_toxic(formula):
    return any(element in formula for element in TOXIC_ELEMENTS)

def compute_semiconductor_fom(band_gap, formation_energy,
                               energy_above_hull, abundance_score):
    ideal_center = 1.75
    band_gap_score = max(0, 1 - abs(band_gap - ideal_center) / 2.0)
    stability_score = min(1.0, abs(formation_energy) / 5.0)
    hull_score = max(0, 1 - energy_above_hull / 0.1)
    abundance_normalized = abundance_score / 10.0
    return round(
        0.35 * band_gap_score +
        0.25 * stability_score +
        0.25 * hull_score +
        0.15 * abundance_normalized, 4
    )

def compute_dielectric_fom(band_gap, formation_energy,
                            energy_above_hull, abundance_score):
    # For gate dielectrics: wide gap + stable + abundant
    # SiO2 baseline: band_gap=8.9, formation=-9.1 eV/atom
    gap_score = min(1.0, band_gap / 10.0)  # higher is better
    stability_score = min(1.0, abs(formation_energy) / 5.0)
    hull_score = max(0, 1 - energy_above_hull / 0.1)
    abundance_normalized = abundance_score / 10.0
    return round(
        0.40 * gap_score +
        0.30 * stability_score +
        0.20 * hull_score +
        0.10 * abundance_normalized, 4
    )

def fetch_and_process(results, mode="semiconductor"):
    candidates = []
    for r in results:
        try:
            formula = r.formula_pretty
            if is_toxic(formula):
                continue
            band_gap = r.band_gap
            formation_energy = r.formation_energy_per_atom
            hull = r.energy_above_hull
            density = r.density
            crystal_system = r.symmetry.crystal_system.value
            mat_id = str(r.material_id)
            abundance = get_abundance_score(formula)

            if mode == "semiconductor":
                fom = compute_semiconductor_fom(
                    band_gap, formation_energy, hull, abundance)
            else:
                fom = compute_dielectric_fom(
                    band_gap, formation_energy, hull, abundance)

            candidates.append({
                "material_id": mat_id,
                "formula": formula,
                "band_gap_eV": round(band_gap, 3),
                "formation_energy": round(formation_energy, 3),
                "energy_above_hull": round(hull, 4),
                "density_g_cm3": round(density, 3),
                "crystal_system": crystal_system,
                "abundance_score": abundance,
                "figure_of_merit": fom,
                "mode": mode
            })
        except Exception as e:
            continue
    return pd.DataFrame(candidates)

