import pandas as pd

def compute_humidity_stability_score(fluoride_formation, 
                                      hydroxide_formation):
    """
    More negative fluoride formation vs hydroxide means
    fluoride is preferred thermodynamically in wet conditions.
    Returns positive score if fluoride is more stable.
    """
    # Both values are per atom, need to normalize by formula units
    # Approximate: if fluoride formation << hydroxide formation
    # the material resists hydration
    delta = hydroxide_formation - fluoride_formation
    return round(delta, 4)  # positive means fluoride preferred

# Reference hydroxide formation energies from literature
# (eV per atom, approximate DFT values)
HYDROXIDE_FORMATION = {
    "Y":  -3.21,   # Y(OH)3
    "Pr": -3.18,   # Pr(OH)3
    "Nd": -3.15,   # Nd(OH)3
    "Dy": -3.12,   # Dy(OH)3
    "Tb": -3.14,   # Tb(OH)3
    "Ho": -3.11,   # Ho(OH)3
    "Sm": -3.09,   # Sm(OH)3
    "Lu": -3.19,   # Lu(OH)3
}

